# ── Ask Jaanvi — Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ── Application ─────────────────────────────────────────────────
APP_NAME="Ask Jaanvi"
APP_VERSION="0.1.0"
DEBUG=true

# ── Server ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# TODO(production): Replace with actual production domain(s).
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Groq LLM ───────────────────────────────────────────────────
# Required for chat functionality (Phase 4+).
# Get your key at https://console.groq.com
GROQ_API_KEY=
# Model will be selected and verified before Phase 4.
GROQ_MODEL=
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT=30.0
